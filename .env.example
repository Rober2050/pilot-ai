# ==============================================================
# PILOT AI — environment variables
# 1. cp .env.example .env.local
# 2. Fill in the two Supabase values below
# 3. Never commit .env.local (already in .gitignore)
# ==============================================================

# --- Supabase (database + auth + Edge Function proxy) ---------
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- AI provider keys: NOT here --------------------------------
# The Anthropic key is a server-side secret of the Edge Function:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Anything prefixed VITE_ ends up in the browser bundle, so never
# put a paid provider key in this file.

# --- Optional: emergency admin emails (comma separated) --------
# Grants admin UI access on the client side only. Real admin rights
# come from the `rol` column — see README "Make yourself admin".
VITE_EMERGENCY_ADMINS=
